{#
  A blog post: /{slug}/ (design: Arrowsystem_local/blogs/blog-detail.html).
    1. Post header: breadcrumb, categories (all; the first is the main one), author, date, reading time, H1 ([brackets] = red),
       lead, cover image
    2. Article + rail: "On this page" (from the H2 Heading and Key Takeaways blocks) + the help box; the article is the
       Article Body blocks, each rendered by _builder/{handle}.twig (the common page-builder blocks, shared with products and industries); then the closing Call to Action
       (the post's own CTA block, else the default from Entries → Blog Page → Default CTA) and the post foot
    3. More Insights: the post's "More Insights" picks, else the latest posts of its main category, else the latest posts
  Reading time = words in the blocks ÷ 225 (the design: 3,127 words → 14 min).
#}
{% extends '_layouts/base' %}
{% import '_macros/layout' as layout %}
{% import '_macros/text' as text %}
{% import '_macros/links' as links %}

{% set blogPage = craft.entries.section('blogPage').one() %}
{% set categories = entry.blogCategories.all() %}
{% set category = categories|first %}{# the main category: breadcrumb, schema, More Insights #}
{% set tags = entry.blogTags.all() %}
{% set author = entry.author %}
{% set authorName = author ? (author.fullName ?: author.username) : null %}
{% set cover = entry.featuredImage.one() %}
{% set plainTitle = entry.title|replace({'[': '', ']': ''}) %}
{% set pageTitle = entry.seoTitle ?: plainTitle ~ ' - ' ~ siteName %}
{% set description = entry.seoDescription ?: entry.sectionLead %}

{# ---- One pass over the blocks: anchors for H2s / Key Takeaways, the contents list, word count ---- #}
{% set blocks = entry.articleBody.with(['stepItems', 'compareColumns', 'productItems', 'faqItems', 'mediaImage', 'galleryImages']).all() %}
{# the top-level blocks + the child blocks in their nested fields (Steps, Comparison, Product List, FAQ) #}
{% set allBlocks = [] %}
{% for block in blocks %}
  {% set allBlocks = allBlocks|merge([block]) %}
  {% for f in ['stepItems', 'compareColumns', 'productItems', 'faqItems'] %}
    {% set kids = attribute(block, f) ?? null %}
    {% if kids %}{% set allBlocks = allBlocks|merge(kids.all()) %}{% endif %}
  {% endfor %}
{% endfor %}
{% set anchors = {} %}
{% set used = [] %}
{% set toc = [] %}
{% set words = [] %}
{% set hasCta = false %}
{% for block in allBlocks %}
  {% set handle = block.type.handle %}
  {% set isSection = (handle == 'heading' and (block.headingLevel.value ?? 'h2') == 'h2') or handle == 'takeaways' %}
  {% if isSection or (handle == 'heading' and block.anchorId) %}
    {% set base = (block.anchorId ?: block.headingText|kebab)|default('section') %}
    {% set id = base %}
    {% for n in 2..50 %}{% if id in used %}{% set id = base ~ '-' ~ n %}{% endif %}{% endfor %}
    {% set used = used|merge([id]) %}
    {% set anchors = anchors|merge({('b' ~ block.id): id}) %}
    {% if isSection and (handle == 'takeaways' or block.showInContents) %}
      {% set toc = toc|merge([{id: id, title: block.tocLabel ?? null ?: block.headingText}]) %}
    {% endif %}
  {% endif %}
  {% if handle == 'cta' %}{% set hasCta = true %}{% endif %}
  {% set words = words|merge([
    block.headingText ?? '', block.answerLead ?? '', block.richText ?? '', block.shortRichText ?? '', block.tableText ?? '',
    block.sectionBody ?? '', block.quoteText ?? '', block.ctaHeading ?? '', block.ctaText ?? '', block.caption ?? '',
    block.productTag ?? '', block.productName ?? '',
    ((block.listItems ?? [])|map(r => r.text))|join(' '),
    ((block.specItems ?? [])|map(r => r.term ~ ' ' ~ r.description))|join(' '),
  ]) %}
{% endfor %}
{# No H2 sections (some older posts only use H3): list the H3 headings instead #}
{% if not toc|length %}
  {% for block in blocks|filter(b => b.type.handle == 'heading' and (b.headingLevel.value ?? '') == 'h3') %}
    {% set id = anchors['b' ~ block.id] ?? null %}
    {% if not id %}
      {% set base = (block.headingText|kebab)|default('section') %}
      {% set id = base %}
      {% for n in 2..50 %}{% if id in used %}{% set id = base ~ '-' ~ n %}{% endif %}{% endfor %}
      {% set used = used|merge([id]) %}
      {% set anchors = anchors|merge({('b' ~ block.id): id}) %}
    {% endif %}
    {% set toc = toc|merge([{id: id, title: block.tocLabel ?? null ?: block.headingText}]) %}
  {% endfor %}
{% endif %}
{% set wordCount = (words|join(' ')|striptags|replace('/\\s+/u', ' ')|trim|split(' ')|filter(w => w|length))|length %}
{% set readMinutes = max(1, (wordCount / 225)|round(0, 'ceil')) %}

{% block title %}{{ pageTitle }}{% endblock %}

{% block seo %}
  {% set published = entry.postDate|atom %}
  {% set modified = entry.dateUpdated|atom %}
  {% set social = entry.socialImage.one() ?? cover %}
  {% import '_macros/text' as text %}
  {% set firstVideo = blocks|filter(b => b.type.handle == 'video' and text.youtubeId(b.videoUrl)|trim|length == 11)|first %}
  {% set crumbs = [{'@type': 'ListItem', position: 1, name: 'Home', item: siteUrl}] %}
  {% if category %}
    {% set crumbs = crumbs|merge([{'@type': 'ListItem', position: 2, name: category.title, item: category.url}]) %}
  {% endif %}
  {% set crumbs = crumbs|merge([{'@type': 'ListItem', position: crumbs|length + 1, name: plainTitle, item: entry.url}]) %}
  {% set posting = {
    '@type': 'BlogPosting',
    '@id': entry.url ~ '#richSnippet',
    headline: pageTitle,
    description: description,
    datePublished: published,
    dateModified: modified,
    articleSection: category.title ?? null,
    wordCount: wordCount,
    author: {'@type': 'Person', name: authorName ?: 'admin'},
    publisher: {'@type': 'Organization', name: siteName, url: siteUrl},
    mainEntityOfPage: {'@id': entry.url ~ '#webpage'},
    inLanguage: currentSite.language,
  } %}
  {% if social %}{% set posting = posting|merge({image: {'@type': 'ImageObject', url: social.url, width: social.width, height: social.height}}) %}{% endif %}
  {% include '_partials/seo' with {
    title: pageTitle,
    description: description,
    canonical: entry.url,
    noindex: entry.seoNoIndex,
    ogType: 'article',
    image: social,
    extraMeta: [
      {property: 'og:updated_time', content: modified},
      {property: 'article:section', content: category.title ?? ''},
      {property: 'article:published_time', content: published},
      {property: 'article:modified_time', content: modified},
      {name: 'twitter:label1', content: 'Written by'},
      {name: 'twitter:data1', content: 'admin'},
      {name: 'twitter:label2', content: 'Time to read'},
      {name: 'twitter:data2', content: readMinutes ~ ' minute' ~ (readMinutes != 1 ? 's')},
    ]|merge(tags|map(t => {property: 'article:tag', content: t.title}))
     |merge(firstVideo ? [{property: 'og:video', content: 'https://www.youtube.com/embed/' ~ text.youtubeId(firstVideo.videoUrl)|trim}] : [])
     |filter(m => m.content),
    schema: [
      {'@type': 'WebPage', '@id': entry.url ~ '#webpage', url: entry.url, name: pageTitle, datePublished: published, dateModified: modified, inLanguage: currentSite.language},
      {'@type': 'BreadcrumbList', '@id': entry.url ~ '#breadcrumb', itemListElement: crumbs},
      posting,
    ],
  } %}
{% endblock %}

{% block head %}
  <link rel="stylesheet" href="{{ url('assets/css/blog.css') }}">
  <link rel="stylesheet" href="{{ url('assets/css/blog-detail.css') }}">
  {% if cover %}<link rel="preload" as="image" href="{{ cover.getUrl({width: min(1600, cover.width)}) }}" fetchpriority="high">{% endif %}{# the same file as the cover <img> #}
  <script src="{{ url('assets/js/blog.js') }}" defer></script>
  <script src="{{ url('assets/js/blog-detail.js') }}" defer></script>
{% endblock %}

{% block beforeMain %}
<div class="read-progress" aria-hidden="true"><span data-read-progress></span></div>
{% endblock %}

{% block content %}
  <section class="page-hero post-hero" aria-labelledby="page-title">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="{{ siteUrl }}">Home</a></li>
          {% if blogPage %}<li><a href="{{ blogPage.url }}">{{ blogPage.title }}</a></li>{% endif %}
          <li><a href="{{ entry.url }}" aria-current="page">{{ plainTitle|split(': ')|first }}</a></li>
        </ol>
      </nav>

      <div class="post-hero__grid">
        <div class="post-hero__body">
          <p class="post-tile__meta post-hero__meta">
            {% for cat in categories %}<a class="post-tile__cat" href="{{ cat.url }}">{{ cat.title }}</a>{% endfor %}
            {% if authorName %}<span class="post-hero__fact post-hero__author">By {{ authorName }}</span>{% endif %}
            <span class="post-hero__fact"><svg class="icon" aria-hidden="true"><use href="#i-calendar"/></svg><time datetime="{{ entry.postDate|date('Y-m-d') }}">{{ entry.postDate|date('F j, Y') }}</time></span>
            <span class="post-hero__fact"><svg class="icon" aria-hidden="true"><use href="#i-clock"/></svg>{{ readMinutes }} min read</span>
          </p>
          <h1 class="post-hero__title" id="page-title">{{ text.highlight(entry.title) }}</h1>
          {% if entry.sectionLead %}<p class="post-hero__lead">{{ entry.sectionLead }}</p>{% endif %}
        </div>

        {% if cover %}
        {# Cover: full width under the title, shown whole at its own proportions (design change 2026-10-16) #}
        <figure class="post-cover">
          <span class="dot-grid dot-grid--hero" aria-hidden="true"></span>
          <span class="crop crop--tl" aria-hidden="true"></span><span class="crop crop--tr" aria-hidden="true"></span>
          <span class="crop crop--bl" aria-hidden="true"></span><span class="crop crop--br" aria-hidden="true"></span>
          {% set coverSize = {width: min(1600, cover.width)} %}{# up to 1600 px wide (shown at 1280 max), never enlarged or cropped #}
          <img src="{{ cover.getUrl(coverSize) }}" width="{{ cover.getWidth(coverSize) }}" height="{{ cover.getHeight(coverSize) }}" fetchpriority="high" alt="{{ cover.alt }}">
        </figure>
        {% endif %}
      </div>
    </div>
  </section>

  <section class="section post-body" aria-label="Article">
    <div class="container post-layout">

      <aside class="post-rail" aria-label="Article navigation">
        {% if toc|length %}
        <details class="toc" data-toc open>
          <summary class="toc__toggle">
            <svg class="icon" aria-hidden="true"><use href="#i-file"/></svg>
            <span>On this page</span>
            <svg class="icon toc__chev" aria-hidden="true"><use href="#i-chevron-down"/></svg>
          </summary>
          <ol class="toc__list">
            {% for item in toc %}
            <li><a class="toc__link" href="#{{ item.id }}">{{ item.title }}</a></li>
            {% endfor %}
          </ol>
        </details>
        {% endif %}

        {% include 'blog/_partials/side-cta' with { blogPage: blogPage, idPrefix: 'rail', extraClass: 'post-rail__cta' } only %}
      </aside>

      <article class="prose" data-article>
        {% for block in blocks %}
          {{ layout.builderBlock(block, anchors) }}
        {% endfor %}

        {% if not hasCta and blogPage and blogPage.ctaHeading %}
          {% include 'blog/_partials/post-cta' with { heading: blogPage.ctaHeading, body: blogPage.ctaText, link: blogPage.ctaLink, id: 'post-cta-title' } only %}
        {% endif %}

        <footer class="post-foot">
          {% if categories|length %}<p class="post-foot__filed">Filed under {% for cat in categories %}<a class="post-tile__cat" href="{{ cat.url }}">{{ cat.title }}</a>{% endfor %}</p>{% endif %}
          {% if tags|length %}<p class="post-foot__filed post-foot__tags">Tagged {% for tag in tags %}<a class="post-tag" href="{{ tag.url }}">#{{ tag.title }}</a>{% endfor %}</p>{% endif %}
          {% if blogPage %}<a class="text-link" href="{{ blogPage.url }}"><svg class="icon post-foot__back" aria-hidden="true"><use href="#i-arrow-right"/></svg> Back to all articles</a>{% endif %}
        </footer>
      </article>
    </div>
  </section>

  {# More Insights: the editor's picks, else the latest from the main category, topped up with the latest posts #}
  {% set more = entry.relatedPosts.with(['featuredImage', 'blogCategories']).all() %}
  {% if more|length < 3 and category %}
    {% set more = more|merge(craft.entries.section('blog').relatedTo({targetElement: category, field: 'blogCategories'})
      .id(['not', entry.id]|merge(more|map(p => p.id))).with(['featuredImage', 'blogCategories']).limit(3 - more|length).all()) %}
  {% endif %}
  {% if more|length < 3 %}
    {% set more = more|merge(craft.entries.section('blog')
      .id(['not', entry.id]|merge(more|map(p => p.id))).with(['featuredImage', 'blogCategories']).limit(3 - more|length).all()) %}
  {% endif %}
  {% if more|length %}
  <section class="section section--surface more-insights" aria-labelledby="more-insights-title">
    <div class="container">
      <header class="section-head section-head--split">
        <div>
          <p class="eyebrow">Keep reading</p>
          <h2 class="section-title" id="more-insights-title">More Insights On <span class="hl">Labels and Packaging</span></h2>
        </div>
        {% if blogPage %}<a class="text-link" href="{{ blogPage.url }}">View all articles <svg class="icon" aria-hidden="true"><use href="#i-arrow-right"/></svg></a>{% endif %}
      </header>
      <ul class="post-tiles post-tiles--three">
        {% for post in more %}
          {% include '_components/post-card' with { post: post } only %}
        {% endfor %}
      </ul>
    </div>
  </section>
  {% endif %}
{% endblock %}
