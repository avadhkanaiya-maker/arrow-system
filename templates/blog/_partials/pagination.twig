{#
  Blog pagination (design: blogs/index.html nav.pagination). URLs: /blog/page/2/ (pageTrigger 'page/' in config/general.php).
  Shows the first and last page, the current page ±1, and "…" for the gaps.
#}
{% set current = pageInfo.currentPage %}
{% set total = pageInfo.totalPages %}
{% set from = max(1, current - 1) %}
{% set to = min(total, max(current + 1, 3)) %}
{% if current == total %}{% set from = max(1, total - 2) %}{% endif %}
<nav class="pagination" aria-label="Blog pages">
  {% if pageInfo.prevUrl %}
    <a class="pagination__step" href="{{ pageInfo.prevUrl }}" rel="prev"><svg class="icon" aria-hidden="true"><use href="#i-chevron-left"/></svg>Previous</a>
  {% else %}
    <span class="pagination__step is-disabled" aria-disabled="true"><svg class="icon" aria-hidden="true"><use href="#i-chevron-left"/></svg>Previous</span>
  {% endif %}
  <ol class="pagination__pages">
    {% if from > 1 %}
      <li><a class="pagination__page" href="{{ pageInfo.getPageUrl(1) }}"><span class="visually-hidden">Page </span>1</a></li>
      {% if from > 2 %}<li class="pagination__gap" aria-hidden="true">&hellip;</li>{% endif %}
    {% endif %}
    {% for page in from..to %}
      <li><a class="pagination__page" href="{{ pageInfo.getPageUrl(page) }}"{{ page == current ? ' aria-current="page"' }}><span class="visually-hidden">Page </span>{{ page }}</a></li>
    {% endfor %}
    {% if to < total %}
      {% if to < total - 1 %}<li class="pagination__gap" aria-hidden="true">&hellip;</li>{% endif %}
      <li><a class="pagination__page" href="{{ pageInfo.getPageUrl(total) }}"><span class="visually-hidden">Page </span>{{ total }}</a></li>
    {% endif %}
  </ol>
  {% if pageInfo.nextUrl %}
    <a class="pagination__step" href="{{ pageInfo.nextUrl }}" rel="next">Next<svg class="icon" aria-hidden="true"><use href="#i-chevron-right"/></svg></a>
  {% else %}
    <span class="pagination__step is-disabled" aria-disabled="true">Next<svg class="icon" aria-hidden="true"><use href="#i-chevron-right"/></svg></span>
  {% endif %}
</nav>
<p class="pagination__summary">Page {{ current }} of {{ total }}</p>
