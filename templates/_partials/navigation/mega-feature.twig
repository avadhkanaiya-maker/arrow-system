{#
  The featured box on the right of the Products mega menu (design: aside.mega__feature). One per category with a Featured
  Product, plus a default with only the extra links; web/assets/js/craft.js shows the open category's box (else the default).
  Vars: title (empty = links only), image (Asset|null), text, link {url, label, target}, extras (menu items listed under
        the box), attrs (data attributes of this box), hidden (bool)
#}
{% import '_macros/nav' as nav %}
{% set title = title ?? null %}
<aside class="mega__feature{{ title ? '' : ' mega__feature--links' }}" aria-label="{{ title ? 'Featured product' : 'More' }}" {{ attrs|raw }}{{ hidden ? ' hidden' }}>
  {% if title %}
  {% if image ?? null %}
    <div class="mega__feature-media">
      <img src="{{ image.url }}" width="{{ image.width }}" height="{{ image.height }}" loading="lazy" alt="{{ image.alt ?: title }}">
    </div>
  {% endif %}
  <p class="mega__feature-kicker">Featured</p>
  <p class="mega__feature-title">{{ title }}</p>
  {% if text ?? null %}<p class="mega__feature-text">{{ text }}</p>{% endif %}
  {% if (link ?? null) and link.url %}
    <a class="text-link" href="{{ link.url }}"{{ link.target ? ' target="_blank" rel="noopener"' }}>{{ link.label }} <svg class="icon" aria-hidden="true"><use href="#i-arrow-right"/></svg></a>
  {% endif %}
  {% endif %}
  {% if extras|length %}
    <ul class="mega__extra">
      {% for node in extras %}
        <li><a {{ nav.attrs(node) }}>{{ node.title }}</a></li>
      {% endfor %}
    </ul>
  {% endif %}
</aside>
