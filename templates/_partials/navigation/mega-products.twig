{#
  Main Menu item with Menu Style "Products mega menu":
    level 2 Group / Column items → groups (Arrow Systems equipment / Partner Brands); other level 2 items → extra links in the box
    level 3 → categories (Passive items; "View All Text" + "View All Text URL" give the "View all" link)
    level 4 → products
  The featured box (mega-feature.twig), on the right:
    a category item's Featured Product → that category's box (the product's Card Photo else Main Image, name, Card
    Tagline, "Explore Product"), shown while the category is open (web/assets/js/craft.js); a category without one →
    only the extra links (the other level 2 items, e.g. Compare Models, Used Equipment). Without JS: the extra links.
#}
{% import '_macros/nav' as nav %}
{% import '_macros/links' as links %}
{% set children = item.children.all() %}
<li class="nav-item nav-item--mega{{ isLast ? ' nav-item--end' }}" data-nav-item>
  <button class="nav-trigger" type="button" aria-expanded="false" aria-controls="{{ panelId }}" data-nav-trigger>
    {{ item.title }} <svg class="icon nav-trigger__chev" aria-hidden="true"><use href="#i-chevron-down"/></svg>
  </button>
  <div class="nav-panel nav-panel--mega" id="{{ panelId }}">
    <div class="mega container" data-feature-group>
      <div class="mega__cats" data-cat-group>
        {% for group in children|filter(n => n.isGroupColumn()) %}
          <p class="mega__label">{{ group.title }}</p>
          <ul class="mega__cat-list">
            {% for cat in group.children.all() %}
              {% set catId = 'cat-' ~ (cat.title|kebab) %}
              <li class="mega__cat" data-cat>
                <button class="mega__cat-btn" type="button" aria-expanded="false" aria-controls="{{ catId }}" data-cat-trigger>
                  {{ cat.title }} <svg class="icon" aria-hidden="true"><use href="#i-chevron-right"/></svg>
                </button>
                <div class="mega__cat-panel" id="{{ catId }}">
                  {% if cat.panelTitle %}<p class="mega__cat-title">{{ cat.panelTitle }}</p>{% endif %}
                  <ul class="mega__links">
                    {% for node in cat.children.all() %}
                      {% set description = nav.description(node)|trim %}
                      <li><a {{ nav.attrs(node) }}>{{ node.title }}{% if description %}<span>{{ description }}</span>{% endif %}</a></li>
                    {% endfor %}
                  </ul>
                  {% set viewAll = cat.viewAllUrl ?? null %}
                  {% if viewAll and viewAll.url and cat.viewAllLabel %}
                    <a class="mega__all" {{ links.attrs(viewAll) }}>{{ cat.viewAllLabel }} <svg class="icon" aria-hidden="true"><use href="#i-arrow-right"/></svg></a>
                  {% endif %}
                </div>
              </li>
            {% endfor %}
          </ul>
        {% endfor %}
      </div>

      {% set extras = children|filter(n => not n.isGroupColumn()) %}
      {% if extras|length %}
        {% include '_partials/navigation/mega-feature' with { extras: extras, attrs: 'data-feature-default', hidden: false } only %}
      {% endif %}
      {% for group in children|filter(n => n.isGroupColumn()) %}
        {% for cat in group.children.all() %}
          {% set product = cat.featuredProduct.one() ?? null %}
          {% if product %}
            {% include '_partials/navigation/mega-feature' with {
              image: product.featuredImage.one() ?? product.mediaImage.one(), title: product.headingText ?: product.title,
              text: product.cardTagline, link: {url: product.url, label: 'Explore Product', target: null},
              extras: extras, attrs: 'data-feature-for="cat-' ~ (cat.title|kebab) ~ '"', hidden: true,
            } only %}
          {% endif %}
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</li>
