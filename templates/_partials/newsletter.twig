{#
  N. Newsletter band (design: index.html, "NEWSLETTER"), at the end of <main> on every page (included by base.twig).
  Content: Globals → Newsletter. "Show Newsletter" off hides it everywhere; on a page with a page builder it shows only
  while the builder has a Newsletter block (base.twig).
  Sign-ups (2026-10-29): the email goes to the Formie form "Newsletter" (handle newsletter, field email: required,
  unique; storage/imports/forms/16_newsletter_form.php). site.js checks the address, posts the form in the background
  and shows the answer (thanks / already subscribed / error). Subscribers: Formie → Submissions → Newsletter.
  Without that form (not created yet) site.js says sign-up isn't connected. beesknees = Formie's honeypot (must be sent,
  empty). Keep the ids (nl-email, nl-note, nl-status) and data-newsletter: site.js uses them.
#}
{% import '_macros/links' as links %}
{% import '_macros/text' as text %}
{% if newsletter.newsletterEnabled ?? false %}
  {% set nlForm = craft.formie.forms().handle('newsletter').one() %}
  {# the form's Email field, whatever its handle (email here, Formie's default emailAddress when made in the CP) #}
  {% set nlEmail = nlForm ? (nlForm.getCustomFields()|filter(f => f is instance of('verbb\\formie\\fields\\Email'))|first) : null %}
  {% set placeholder = newsletter.emailPlaceholder ?: 'Your email' %}
  {% set link = newsletter.noteLink %}
  <section class="newsletter" aria-labelledby="newsletter-title">
    <div class="container newsletter__inner">
      <div class="newsletter__intro">
        <h2 id="newsletter-title">{{ text.highlight(newsletter.sectionHeading) }}</h2>
        {% if newsletter.sectionLead %}<p>{{ newsletter.sectionLead }}</p>{% endif %}
      </div>
      <form class="newsletter__form" method="post" action="{{ actionUrl('formie/submissions/submit') }}" novalidate data-newsletter data-integration="{{ nlForm ? 'formie' : 'pending' }}">
        {% if nlForm %}
          {{ csrfInput() }}
          <input type="hidden" name="handle" value="newsletter">
          <div class="visually-hidden" aria-hidden="true"><label for="nl-beesknees">Leave this field empty</label><input id="nl-beesknees" type="text" name="beesknees" value="" tabindex="-1" autocomplete="off"></div>
        {% endif %}
        <div class="newsletter__row">
          <div class="field">
            <label class="visually-hidden" for="nl-email">{{ placeholder }}</label>
            <input id="nl-email" name="fields[{{ nlEmail.handle ?? 'email' }}]" type="email" autocomplete="email" required placeholder="{{ placeholder }}" aria-describedby="nl-status nl-note">
          </div>
          <button class="btn btn--primary" type="submit">{{ newsletter.buttonLabel ?: 'Subscribe' }}</button>
        </div>
        {% if newsletter.noteText or (link and link.url) %}
          <p class="newsletter__note" id="nl-note">
            {{- newsletter.noteText -}}
            {%- if link and link.url %}{{ newsletter.noteText ? ' ' }}See our <a {{ links.attrs(link) }}>{{ link.label }}</a>.{% endif -%}
          </p>
        {% endif %}
        <p class="form-status" id="nl-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
{% endif %}
