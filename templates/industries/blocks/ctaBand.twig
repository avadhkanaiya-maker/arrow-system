{# CTA Band (shared with the homepage: Heading, Intro, Button, Second Button, Anchor ID) as the industries' maroon help band (design: industries/index.html "HELP BAND"). Both buttons are the admin's, each shown when filled in. Vars: block #}
{% import '_macros/layout' as layout %}
{% import '_macros/text' as text %}
{% import '_macros/links' as links %}
{% set anchor = block.anchorId|trim ?: 'section-' ~ block.id %}
  <section class="sustain ind-cta{{ layout.customClass(block) }}" id="{{ anchor }}" aria-labelledby="{{ anchor }}-title">
    <span class="dot-grid dot-grid--cta-a" aria-hidden="true"></span>
    <span class="dot-grid dot-grid--cta-b" aria-hidden="true"></span>
    <div class="container sustain__inner">
      <h2 id="{{ anchor }}-title">{{ text.highlight(block.sectionHeading) }}</h2>
      {% if block.sectionLead %}<p>{{ block.sectionLead }}</p>{% endif %}
      <div class="btn-row ind-cta__actions">
        {% if block.ctaLink and block.ctaLink.url %}<a class="btn btn--light btn--lg" {{ links.attrs(block.ctaLink) }}>{{ block.ctaLink.label }}</a>{% endif %}
        {% if block.secondaryCta and block.secondaryCta.url %}<a class="btn btn--outline-light btn--lg" {{ links.attrs(block.secondaryCta) }}>{{ block.secondaryCta.label }}</a>{% endif %}
      </div>
    </div>
  </section>
