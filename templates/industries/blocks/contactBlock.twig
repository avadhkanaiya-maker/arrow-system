{#
  4. Contact (design: ".ind-contact"): maroon panel (small heading, heading, text; phones, email, address from Site
  Settings) + the contact form (Name*, Email*, Contact No.*, Message, as live). NOT connected yet (HubSpot pending):
  js/industries/industry-detail.js checks the fields and says so. Privacy link: Globals → Newsletter → note link.
  Vars: block
#}
{% import '_macros/links' as links %}
{% set anchor = block.anchorId|trim ?: 'contact' %}
{% set privacy = newsletter.noteLink ?? null %}
  <section class="section ind-contact" id="{{ anchor }}" aria-labelledby="{{ anchor }}-title">
    <div class="container ind-contact__grid">
      <div class="contact-panel">
        <span class="dot-grid dot-grid--panel" aria-hidden="true"></span>
        {% if block.eyebrow %}<p class="contact-panel__eyebrow">{{ block.eyebrow }}</p>{% endif %}
        <h2 class="contact-panel__title" id="{{ anchor }}-title">{{ block.sectionHeading ?: 'Contact With Our Team Now' }}</h2>
        {% if block.sectionLead %}<p>{{ block.sectionLead }}</p>{% endif %}
        <ul class="contact-panel__list">
          {% if siteSettings.tollFreePhone %}<li><svg class="icon" aria-hidden="true"><use href="#i-phone"/></svg><span>Toll-free <a href="tel:{{ links.tel(siteSettings.tollFreePhone) }}">{{ siteSettings.tollFreePhone }}</a></span></li>{% endif %}
          {% if siteSettings.directPhone %}<li><svg class="icon" aria-hidden="true"><use href="#i-phone"/></svg><span>Direct <a href="tel:{{ links.tel(siteSettings.directPhone) }}">{{ siteSettings.directPhone }}</a></span></li>{% endif %}
          {% if siteSettings.salesEmail %}<li><svg class="icon" aria-hidden="true"><use href="#i-mail"/></svg><a href="mailto:{{ siteSettings.salesEmail }}">{{ siteSettings.salesEmail }}</a></li>{% endif %}
          {% if siteSettings.address %}<li><svg class="icon" aria-hidden="true"><use href="#i-map-pin"/></svg><span>{{ siteSettings.address }}</span></li>{% endif %}
        </ul>
      </div>
      <form class="contact-form" novalidate data-contact-form data-integration="hubspot-pending" aria-labelledby="{{ anchor }}-title">
        <div class="contact-form__row">
          <div class="form-field">
            <label for="cf-name">Name <span class="req" aria-hidden="true">*</span></label>
            <input id="cf-name" name="name" type="text" autocomplete="name" required>
          </div>
          <div class="form-field">
            <label for="cf-email">Email <span class="req" aria-hidden="true">*</span></label>
            <input id="cf-email" name="email" type="email" autocomplete="email" required>
          </div>
        </div>
        <div class="form-field">
          <label for="cf-phone">Contact No. <span class="req" aria-hidden="true">*</span></label>
          <input id="cf-phone" name="phone" type="tel" autocomplete="tel" required placeholder="With country code">
        </div>
        <div class="form-field">
          <label for="cf-message">Message</label>
          <textarea id="cf-message" name="message" rows="5" placeholder="Your requirement or a query"></textarea>
        </div>
        <p class="contact-form__note"><span aria-hidden="true">*</span> Required.{% if privacy and privacy.url %} See our <a {{ links.attrs(privacy) }}>{{ privacy.label }}</a>.{% endif %}</p>
        <button class="btn btn--primary btn--lg" type="submit">Send</button>
        <p class="form-status" role="status" aria-live="polite" data-form-status></p>
      </form>
    </div>
  </section>
