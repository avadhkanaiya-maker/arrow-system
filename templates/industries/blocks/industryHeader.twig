{# 1. Page Header (industries and Pages; design: ".ind-detail-hero"): breadcrumb, small heading, H1 ([red] words), intro (a blank
   line = a new paragraph), applications, image (empty = the page's Card Photo, else its Social Image), buttons.
   Header Style: Image beside text (default) · Full-width banner (.page-banner, craft.css): the text first, then the image
   on its own across the full content width, shown whole (not cropped, nothing on it), as the blog posts' cover; without
   an image it falls back to the default. Banner Height "Short strip": a cropped band instead of the whole image.
   No image at all: the text across the full width (the banner layout without the picture).
   "Small illustration": a compact header, the text across the full width and the image small at the right as decoration
   (desktop only; e.g. Try a Free Sample's sample pack, an SVG). "Cut-out image beside text": a product cut-out
   (transparent background) whole and large beside the text, no frame; desktop only (e.g. the Digital Label Printers listing).
   Subtitle (Subheading): an H2 line under the heading. Highlights (icon, title, text): a row of points under the text
   (craft.css .highlights); with them a cut-out image shows on wide screens only (the design's .fp-hero).
   Vars: block, entry, listingPage #}
{% import '_macros/layout' as layout %}
{% import '_macros/text' as text %}
{% import '_macros/links' as links %}
{% set image = block.mediaImage.one() ?? entry.featuredImage.one() ?? entry.socialImage.one() %}
{% set banner = image and (block.headerStyle.value ?? '') == 'banner' %}
{% set art = image and (block.headerStyle.value ?? '') == 'illustration' %}
{% set cutout = image and (block.headerStyle.value ?? '') == 'cutout' %}
{% set highlights = (block.highlightItems ?? [])|filter(row => row.title|trim or row.text|trim) %}
  <section class="page-hero ind-detail-hero{{ banner or art or not image ? ' page-banner' }}{{ art ? ' page-hero--art' }}{{ cutout ? ' page-hero--cutout' }}{{ highlights|length ? ' page-hero--highlights' }}{{ layout.customClass(block) }}" aria-labelledby="page-title">
    {% if art %}<img class="page-hero__art" src="{{ image.url }}" width="{{ image.width }}" height="{{ image.height }}" alt="" aria-hidden="true">{% endif %}
    <div class="container">
      {% include 'industries/blocks/_breadcrumb' with { entry: entry, listingPage: listingPage } only %}
      <div class="ind-detail-hero__grid">
        <div class="ind-detail-hero__body">
          {% if block.eyebrow %}<p class="eyebrow">{{ block.eyebrow }}</p>{% endif %}
          <h1 class="ind-detail-hero__title" id="page-title">{{ text.highlight(block.sectionHeading ?: entry.title) }}</h1>
          {% if block.subheading ?? null %}<h2 class="ind-detail-hero__subtitle">{{ block.subheading }}</h2>{% endif %}
          {% for para in (block.sectionLead ?? '')|split('\n\n')|map(p => p|trim)|filter(p => p) %}<p class="ind-detail-hero__lead">{{ para }}</p>{% endfor %}
          {% set apps = (block.listItems ?? [])|filter(row => row.text|trim) %}
          {% if apps|length %}
          <ul class="app-tags" aria-label="Applications">
            {% for row in apps %}
            <li>{{ row.text }}</li>
            {% endfor %}
          </ul>
          {% endif %}
          {% if highlights|length %}
          <ul class="highlights" aria-label="Highlights">
            {% for row in highlights %}
            <li><span class="ico" aria-hidden="true"><svg class="icon"><use href="#i-{{ row.icon ?: 'check' }}"/></svg></span><span>{% if row.title %}<strong>{{ row.title|md(inlineOnly=true, encode=true)|parseRefs }}</strong>{% endif %}{{ row.text|md(inlineOnly=true, encode=true)|parseRefs }}</span></li>
            {% endfor %}
          </ul>
          {% endif %}
          {% if (block.primaryCta and block.primaryCta.url) or (block.secondaryCta and block.secondaryCta.url) %}
          <div class="btn-row">
            {% if block.primaryCta and block.primaryCta.url %}<a class="btn btn--primary btn--lg" {{ links.attrs(block.primaryCta) }}>{{ block.primaryCta.label }}</a>{% endif %}
            {% if block.secondaryCta and block.secondaryCta.url %}<a class="btn btn--outline btn--lg" {{ links.attrs(block.secondaryCta) }}>{{ block.secondaryCta.label }}</a>{% endif %}
          </div>
          {% endif %}
        </div>
        {% if cutout %}
        <img class="ind-detail-hero__cutout" src="{{ image.url }}" width="{{ image.width }}" height="{{ image.height }}" fetchpriority="high" alt="{{ image.alt }}">
        {% elseif image and not banner and not art %}
        <figure class="ind-detail-hero__media">
          <span class="dot-grid dot-grid--hero" aria-hidden="true"></span>
          <span class="crop crop--tl" aria-hidden="true"></span><span class="crop crop--tr" aria-hidden="true"></span>
          <span class="crop crop--bl" aria-hidden="true"></span><span class="crop crop--br" aria-hidden="true"></span>
          <img src="{{ image.url }}" width="{{ image.width }}" height="{{ image.height }}" fetchpriority="high" alt="{{ image.alt }}">
        </figure>
        {% endif %}
      </div>
      {% if banner %}
      <figure class="page-banner__cover{{ (block.bannerHeight.value ?? '') == 'strip' ? ' page-banner__cover--strip' }}">
        <span class="dot-grid dot-grid--hero" aria-hidden="true"></span>
        <span class="crop crop--tl" aria-hidden="true"></span><span class="crop crop--tr" aria-hidden="true"></span>
        <span class="crop crop--bl" aria-hidden="true"></span><span class="crop crop--br" aria-hidden="true"></span>
        {% set size = {width: min(1600, image.width)} %}{# up to 1600 px wide (shown at 1280 max), never enlarged or cropped #}
        <img src="{{ image.getUrl(size) }}" width="{{ image.getWidth(size) }}" height="{{ image.getHeight(size) }}" fetchpriority="high" alt="{{ image.alt }}">
      </figure>
      {% endif %}
    </div>
  </section>
