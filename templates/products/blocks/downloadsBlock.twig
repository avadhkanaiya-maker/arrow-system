{# Downloads block: heading + ul.downloads in a white panel. Vars: block #}
        <div class="pd-block" id="block-{{ block.id }}">
          {% if block.headingText %}<h3 class="pd-block__title">{{ block.headingText }}</h3>{% endif %}
          {% include 'products/blocks/_downloads' with { items: block.downloadItems.with(['downloadFile']).all() } only %}
        </div>
