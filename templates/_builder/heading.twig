{# Heading block: H2 (section, with id for "On this page") / H3–H6, optionally a link, + optional small heading (p.eyebrow) and answer lead (p.answer) #}
{% import '_macros/links' as links %}
{% set level = block.headingLevel.value ?: 'h2' %}
{% set id = anchors['b' ~ block.id] ?? (block.anchorId|trim ?: null) %}{# anchors: the blog's contents list; elsewhere the Anchor ID #}
{% set link = block.headingLink ?? null %}
{% if block.eyebrow ?? null %}<p class="eyebrow">{{ block.eyebrow }}</p>{% endif %}
<{{ level }}{% if id %} id="{{ id }}"{% endif %}>{% if link and link.url %}<a {{ links.attrs(link) }}>{{ block.headingText }}</a>{% else %}{{ block.headingText }}{% endif %}</{{ level }}>
{% if block.answerLead %}<p class="answer">{{ block.answerLead }}</p>{% endif %}
