{# FAQ block: div.faq, one details.faq__item per FAQ Item in its nested field (faqItems) #}
<div class="faq">
  {% for item in block.faqItems.all() %}
  <details class="faq__item">
    <summary class="faq__q">{{ item.headingText }}</summary>
    <div class="faq__a">{{ item.richText }}</div>
  </details>
  {% endfor %}
</div>
