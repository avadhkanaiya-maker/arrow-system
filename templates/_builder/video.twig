{# Video block: a YouTube embed, 16:9 (craft.css .prose-video) #}
{% import '_macros/text' as text %}
{% set id = text.youtubeId(block.videoUrl)|trim %}
{% if id|length == 11 %}
<figure class="prose-video">
  <div class="prose-video__frame">
    <iframe src="https://www.youtube-nocookie.com/embed/{{ id }}" title="{{ block.caption ?: 'YouTube video' }}" loading="lazy" allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
  </div>
  {% if block.caption %}<figcaption>{{ block.caption }}</figcaption>{% endif %}
</figure>
{% endif %}
