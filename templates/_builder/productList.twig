{#
  Product List block: ul.product-list, one li.product-item per Product (productItems).
  A Product linked to an ENTRY takes its photo (Card Photo, else Main Image), name (Card Title, else title) and text
  (Card Tagline) from it, like the Recommended Products cards; the item's own Image / Name / Description override them.
  A pasted URL uses the item's own fields only. A Product with no name at all is left out. Vars: block
#}
{% import '_macros/links' as links %}
{% set rows = [] %}
{% for item in block.productItems.with(['mediaImage']).all() %}
  {% set link = item.ctaLink and item.ctaLink.url ? item.ctaLink : null %}
  {% set product = link and link.type == 'entry' ? link.element : null %}
  {% set name = item.productName ?: (product ? ((product.headingText ?? null) ?: product.title) : null) %}
  {% set image = item.mediaImage.one() %}
  {% if not image and product %}{# any entry type: a field missing from its layout is null ("is defined" is still true), so ?? skips it #}
    {% set image = product.featuredImage.one() ?? product.mediaImage.one() ?? null %}
  {% endif %}
  {% if name %}
    {% set rows = rows|merge([{item: item, link: link, name: name, image: image, text: item.sectionBody ?: (product.cardTagline ?? null)}]) %}
  {% endif %}
{% endfor %}
{% if rows|length %}
<ul class="product-list{{ rows|filter(r => r.image)|length ? ' product-list--media' }}">
  {% for row in rows %}
  <li class="product-item">
    {% if row.image %}
      <div class="product-item__media"><img src="{{ row.image.url }}" width="{{ row.image.width }}" height="{{ row.image.height }}" loading="lazy" decoding="async" alt="{{ row.image.alt ?: row.name }}"></div>
    {% endif %}
    {% if row.item.productTag %}<p class="product-item__tag">{{ row.item.productTag }}</p>{% endif %}
    <h4 class="product-item__name">{% if row.link %}<a {{ links.attrs(row.link) }}>{{ row.name }}</a>{% else %}{{ row.name }}{% endif %}</h4>
    {% if row.text %}<p>{{ row.text }}</p>{% endif %}
  </li>
  {% endfor %}
</ul>
{% endif %}
